# Multi-arch build for Quarkus lolcat service
# Supports aarch64 and amd64
# Using Red Hat UBI9 images

FROM --platform=$BUILDPLATFORM registry.access.redhat.com/ubi9/openjdk-21:latest AS builder

ARG TARGETPLATFORM
ARG BUILDPLATFORM

USER 0

WORKDIR /workspace

# Copy pom.xml
COPY quarkus/pom.xml ./

# Download dependencies
RUN mvn dependency:go-offline

# Copy source code
COPY quarkus/src ./src

# Build the application
RUN mvn clean package -DskipTests

# Final stage - use UBI9 OpenJDK 21 runtime
FROM --platform=$TARGETPLATFORM registry.access.redhat.com/ubi9/openjdk-21-runtime:latest

USER 0

WORKDIR /app

# Copy the Quarkus app from builder
COPY --from=builder /workspace/target/quarkus-app/lib/ ./lib/
COPY --from=builder /workspace/target/quarkus-app/*.jar ./
COPY --from=builder /workspace/target/quarkus-app/app/ ./app/
COPY --from=builder /workspace/target/quarkus-app/quarkus/ ./quarkus/

# Change ownership to default user
RUN chown -R 1001:0 /app

# Run as non-root user (default in UBI)
USER 1001

EXPOSE 4003

ENV PORT=4003

CMD ["java", "-jar", "quarkus-run.jar"]
