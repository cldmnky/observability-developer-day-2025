# Multi-arch build for Node.js web application
# Supports aarch64 and amd64
# Using Red Hat UBI9 images

FROM --platform=$TARGETPLATFORM registry.access.redhat.com/ubi9/nodejs-20:latest

ARG TARGETPLATFORM

USER 0

WORKDIR /app

# Copy package files
COPY node/package*.json ./

# Install dependencies
RUN npm ci --only=production

# Copy application source
COPY node/src/ ./src/
COPY node/public/ ./public/

# Set ownership to root group and ensure group has same permissions as owner
# This allows OpenShift to run the container with arbitrary UIDs in the root group
RUN chgrp -R 0 /app && \
    chmod -R g=u /app

# Run as non-root user (default in UBI)
USER 1001

EXPOSE 4002

ENV PORT=4002

CMD ["npm", "start"]
