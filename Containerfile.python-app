# Multi-arch build for Python seed generator service
# Supports aarch64 and amd64
# Using Red Hat UBI9 images

FROM --platform=$TARGETPLATFORM registry.access.redhat.com/ubi9/python-312:latest

ARG TARGETPLATFORM

USER 0

WORKDIR /app

# Copy requirements and install dependencies
COPY python/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY python/app.py .

# Set ownership to root group and ensure group has same permissions as owner
# This allows OpenShift to run the container with arbitrary UIDs in the root group
RUN chgrp -R 0 /app && \
    chmod -R g=u /app

# Run as non-root user (default in UBI)
USER 1001

EXPOSE 4004

ENV PORT=4004

CMD ["python", "app.py"]
